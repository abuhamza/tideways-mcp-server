{
  "semi": true,
  "trailingComma": "es5",
  "singleQuote": true,
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "bracketSpacing": true,
  "arrowParens": "avoid",
  "overrides": [
    {
      "files": ["manifest.json", "server.json"],
      "options": { "parser": "json-stringify" }
    },
    {
      "files": "*.{yml,yaml}",
      "options": { "singleQuote": false }
    }
  ]
}
