{
  "name": "tideways-mcp-server",
  "version": "2.1.0",
  "description": "MCP server that lets AI assistants query Tideways PHP performance monitoring data",
  "type": "module",
  "bin": {
    "tideways-mcp-server": "dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tideways",
    "performance-monitoring",
    "ai-assistant",
    "php-monitoring",
    "npx",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Mouhammed Diop",
  "license": "MIT",
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@commitlint/cli": "^18.4.0",
    "@commitlint/config-conventional": "^18.4.0",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.2.0",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "external-editor": {
      "tmp": "^0.2.6"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abuhamza/tideways-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/abuhamza/tideways-mcp-server/issues"
  },
  "homepage": "https://github.com/abuhamza/tideways-mcp-server#readme",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.2.0",
    "zod": "^4.6.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts' '*.{ts,js}'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts' '*.{ts,js}'",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "clean": "node -e \"for (const d of ['dist','coverage']) require('node:fs').rmSync(d,{recursive:true,force:true})\"",
    "prepack": "npm run build"
  },
  "mcpName": "io.github.abuhamza/tideways-mcp-server"
}
