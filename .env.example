# Tideways MCP Server — example environment (for local runs: node --env-file=.env dist/index.js)
# MCP clients pass these through their server config; the server does not read .env itself.

# Required: Tideways API token (Organization settings → API Access), scopes: metrics, traces, errors
TIDEWAYS_TOKEN=your_tideways_api_token_here

# Optional: default project, "project" or "organization/project"
# (if unset and the token reaches exactly one project, that one is used)
TIDEWAYS_PROJECT=

# Optional: organization (derived from the token if unset)
TIDEWAYS_ORG=

# Optional: default environment (API default: production) and service (API default: project default)
TIDEWAYS_ENV=
TIDEWAYS_SERVICE=

# Optional: API base URL (must be https) and request timeout in ms
TIDEWAYS_BASE_URL=https://app.tideways.io/apps/api
TIDEWAYS_REQUEST_TIMEOUT=30000

# Optional: debug | info | warn | error (logs go to stderr)
LOG_LEVEL=info
